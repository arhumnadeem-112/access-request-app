# Python virtual environment (recreate it with: python3 -m venv .venv)
.venv/

# Python bytecode caches
__pycache__/
*.pyc

# The SQLite database is generated by seed.py, so it isn't checked in
access.db

# Secrets: never commit these
.secret_key
.env

# Claude Code's per-machine permission settings
.claude/settings.local.json

# macOS clutter
.DS_Store
